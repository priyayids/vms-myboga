# Copy to .env and fill in. NEVER commit the real .env — it is already gitignored.
#
#   local dev:  cp .env.example .env
#   VPS:        see deploy/deploy.sh, which generates this file with a random
#               DB password and mode 600.

# --- Database -----------------------------------------------------------
# DB_URL is only needed for local runs (the app talks to the compose service
# "db" by name inside Docker). docker-compose.prod.yml overrides it.
DB_URL=jdbc:postgresql://localhost:5432/visitor_bridge
DB_NAME=visitor_bridge
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Nuveq Access Control API -------------------------------------------
NUVEQ_BASE_URL=https://api-v2.nuveq.cloud
# Partner API key from the Nuveq dashboard.
NUVEQ_API_KEY=

# Card event delivery:
#   polling = this service pulls GET /api/events on an interval (default)
#   webhook = Nuveq POSTs to https://api.app-cube.tech/api/events/nuveq-webhook
#             and requires that callback URL to be configured in Nuveq first.
NUVEQ_EVENT_MODE=polling
NUVEQ_POLL_INTERVAL_MS=10000

# --- Public URL ---------------------------------------------------------
# Absolute base used when building QR-code URLs handed out to visitors.
APP_BASE_URL=https://api.app-cube.tech

# --- Container registry (docker-compose.prod.yml only) ------------------
GHCR_OWNER=priyayids
